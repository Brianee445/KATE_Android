<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned: no draggable bubble, no ring, no mic-badge chrome.
     Kate's logo is the only visual, non-interactive - it pops in with a
     brief rotation on any wake trigger purely to acknowledge "I heard
     you", then disappears again once the interaction is done (see
     KateOverlayService's show/hideOverlayBubble + playActivationPop).
     The result card below it appears only for Calculate/WebSearch
     answers, directly under the logo, and disappears with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/kate_avatar"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/circle_clip_mask"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:elevation="8dp"
        android:src="@drawable/kate_avatar_idle" />

    <FrameLayout
        android:id="@+id/overlay_expanded"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/overlay_expanded_background"
        android:elevation="12dp"
        android:visibility="gone">

        <include layout="@layout/overlay_expanded_content" />

    </FrameLayout>

</LinearLayout>
