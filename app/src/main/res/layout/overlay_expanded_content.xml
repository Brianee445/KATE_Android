<?xml version="1.0" encoding="utf-8"?>
<!-- Simplified to just the result text - the header (title/close button)
     and quick-actions row (mic/apps/type buttons) below were dead UI,
     never wired to any click listener in Kotlin, and didn't fit the
     new "just a result card for search/calculate" design anyway. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Result area - wrap_content so the card sizes to whatever text
         it's given; KateOverlayService caps this at a max height and
         lets it scroll beyond that, so a long search answer doesn't
         grow the card off-screen. -->
    <ScrollView
        android:id="@+id/overlay_transcript_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#252030"
        android:padding="12dp">

        <TextView
            android:id="@+id/overlay_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Say something..."
            android:textColor="#F5F3F7"
            android:textSize="15sp" />
    </ScrollView>

</LinearLayout>
