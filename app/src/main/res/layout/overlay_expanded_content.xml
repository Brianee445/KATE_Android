<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/overlay_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_clip_mask"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/kate_avatar_idle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Kate Assistant"
            android:textColor="#F5F3F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/overlay_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Conversation area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="12dp"
        android:background="#252030"
        android:padding="12dp">

        <TextView
            android:id="@+id/overlay_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Say something..."
            android:textColor="#A79AB8"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- Quick actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/overlay_mic_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/overlay_mic_button"
            android:contentDescription="Mic" />

        <Button
            android:id="@+id/overlay_apps_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/overlay_apps_button"
            android:contentDescription="Apps" />

        <Button
            android:id="@+id/overlay_type_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/overlay_type_button"
            android:contentDescription="Type" />
    </LinearLayout>

</LinearLayout>
